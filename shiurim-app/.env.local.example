# Supabase - get these from your Supabase project dashboard
# Settings > API > Project URL and anon/public key
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ---------------------------------------------------------------------------
# Google Drive ingest (scripts/drive-sync.mjs) — only needed to run the Drive
# sync locally / for the backfill. The daily job reads these from GitHub secrets.
# Full service-account JSON key (raw or base64). Create a GCP service account,
# enable the Drive API, and have the folder owner Share the roots (Viewer) with
# the service account's client_email. Root folder ids live in data/drive-folders.json.
# ---------------------------------------------------------------------------
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account", ...}
# Plus the shared ingest secrets the worker reuses: R2_*, SUPABASE_SERVICE_ROLE_KEY,
# INGEST_SECRET, VERCEL_DEPLOY_HOOK_URL, RESEND_API_KEY, ADMIN_EMAIL.
# INGEST_COMPLETE_URL defaults to production; set locally only to target a dev endpoint.
